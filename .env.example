NEXT_PUBLIC_API_URL=http://localhost:4000
# Public origin of this site (canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:7501

# Google Analytics 4 measurement ID (optional; analytics is off when unset). Baked in at build time.
NEXT_PUBLIC_GA_ID=

# Shared secret the API sends to POST /api/revalidate (set the same value in the API service)
REVALIDATE_SECRET=change-me-to-a-long-random-string

# reCAPTCHA v3 site key (optional; the check is skipped when unset). The API needs the matching RECAPTCHA_SECRET.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
